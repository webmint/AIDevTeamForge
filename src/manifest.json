{
  "version": "1.28.0",
  "description": "Manifest for AIDevTeamForge update system",

  "templateOwned": {
    "description": "Files 100% owned by the template — safe to overwrite on update. Each entry maps template-repo source path to installed-target path.",
    "files": [
      { "source": "src/commands/breakdown.md",              "target": ".claude/commands/breakdown.md" },
      { "source": "src/commands/constitute.md",             "target": ".claude/commands/constitute.md" },
      { "source": "src/commands/execute-task.md",           "target": ".claude/commands/execute-task.md" },
      { "source": "src/commands/plan.md",                   "target": ".claude/commands/plan.md" },
      { "source": "src/commands/setup-wizard.md",           "target": ".claude/commands/setup-wizard.md" },
      { "source": "src/commands/specify.md",                "target": ".claude/commands/specify.md" },
      { "source": "src/commands/onboard.md",                "target": ".claude/commands/onboard.md" },
      { "source": "src/commands/verify.md",                 "target": ".claude/commands/verify.md" },
      { "source": "src/commands/fix.md",                    "target": ".claude/commands/fix.md" },
      { "source": "src/commands/refactor.md",               "target": ".claude/commands/refactor.md" },
      { "source": "src/commands/report-bug.md",             "target": ".claude/commands/report-bug.md" },
      { "source": "src/commands/refresh-docs.md",           "target": ".claude/commands/refresh-docs.md" },
      { "source": "src/commands/research.md",               "target": ".claude/commands/research.md" },
      { "source": "src/commands/summarize.md",              "target": ".claude/commands/summarize.md" },
      { "source": "src/commands/security.md",               "target": ".claude/commands/security.md" },
      { "source": "src/commands/review.md",                 "target": ".claude/commands/review.md" },
      { "source": "src/commands/audit.md",                  "target": ".claude/commands/audit.md" },
      { "source": "src/commands/finalize.md",               "target": ".claude/commands/finalize.md" },
      { "source": "src/commands/_recovery.md",              "target": ".claude/commands/_recovery.md" },
      { "source": "src/commands/_agent-assignment.md",      "target": ".claude/commands/_agent-assignment.md" },
      { "source": "src/commands/_context-maintenance.md",   "target": ".claude/commands/_context-maintenance.md" },
      { "source": "src/commands/_multi-task-continuation.md", "target": ".claude/commands/_multi-task-continuation.md" },
      { "source": "src/commands/_tech-writer-onboarding.md", "target": ".claude/commands/_tech-writer-onboarding.md" },
      { "source": "src/manifest.json",                      "target": ".claude/template-manifest.json" },
      { "source": "scripts/**",                             "target": "scripts/**" }
    ]
  },

  "templateDerived": {
    "description": "Template files whose changes should propagate to generated files in target projects. Only updates files that already exist in the target (i.e., agents the project chose to install). Placeholder variables are substituted using .devforge/project-config.json.",
    "mappings": [
      {
        "source": "generated:agents",
        "target": ".claude/agents",
        "description": "Generated by scripts/generate-agents.py from src/agents/*.md. Claude-native YAML+markdown files. Three-way merge preserves project customizations."
      },
      {
        "source": "generated:agents",
        "target": ".codex/agents",
        "description": "Generated by scripts/generate-agents.py from src/agents/*.md. Codex-native TOML files."
      },
      {
        "source": "generated:coreLLM",
        "target": "CLAUDE.md",
        "description": "Generated by scripts/generate-corellm.py from src/files/coreLLM/SOURCE.md. Three-way merge preserves project customizations."
      },
      {
        "source": "generated:coreLLM",
        "target": "AGENTS.md",
        "description": "Generated by scripts/generate-corellm.py from src/files/coreLLM/SOURCE.md. Codex CLI equivalent of CLAUDE.md."
      }
    ]
  },

  "projectOwned": {
    "description": "Files generated/customized per-project — NEVER overwrite",
    "patterns": [
      "constitution.md",
      ".claude/project-config.json",
      ".claude/memory/**",
      ".claude/settings.json",
      ".claude/settings.local.json",
      ".claude/session-state.md",
      ".claude/wip.md",
      "specs/**",
      "bugs/**",
      "docs/**",
      ".claude/agents/.baseline/**",
      ".claude/.baseline/**",
      "DEVELOPMENT-STATUS.md"
    ]
  },

  "mergeFiles": {
    "description": "Files with both template and project content — smart merge required",
    "files": {
      ".mcp.json": {
        "strategy": "union_keys",
        "description": "Union of mcpServers keys — add new template servers, keep existing project servers",
        "mergeKey": "mcpServers"
      },
      ".gitignore": {
        "strategy": "union_lines",
        "description": "Add new template lines, keep existing project lines"
      }
    }
  },

  "templateRepoOnly": {
    "description": "Files that exist only in the template repo — NOT copied to target projects during install or update",
    "patterns": [
      ".claude/commands/release.md",
      "install.sh",
      "update.sh",
      "AI-ISSUES-AUDIT.md",
      "COMPETITIVE-ANALYSIS.md",
      "QUALITY-AUDIT.md"
    ]
  },

  "copyIfMissing": {
    "description": "Files to copy only if they don't exist in the target project",
    "patterns": [
      "specs/.gitkeep",
      "bugs/.gitkeep",
      "research/.gitkeep"
    ]
  }
}
