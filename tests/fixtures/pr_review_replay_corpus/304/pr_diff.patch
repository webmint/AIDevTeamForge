+<template>
+  <div class="order-internal-ship-to-column">
+    <div class="ship-to-label">
+      SHIP-TO-ADDRESS <span class="required">*</span>
+    </div>
+    <div v-if="loading" class="loading-indicator">
+      Loading ship-to locations...
+    </div>
+    <div v-else-if="shipToOptions.length === 1" class="single-ship-to">
+      <span>{{ selectedOrg.name || '' }}</span>
+      <span>{{ selectedOrg.sapCustomerId || '' }}</span>
+    </div>
+    <div v-else class="ship-to-dropdown-wrapper">
+      <select
+        v-model="selectedShipTo"
+        class="ship-to-select"
+        :disabled="isReadOnly"
+        @change="onShipToChange"
+      >
+        <option value="">Select ship-to location</option>
+        <option
+          v-for="org in shipToOptions"
+          :key="org.id"
+          :value="org.id"
+        >
+          {{ org.name }} ({{ org.sapCustomerId }})
+        </option>
+      </select>
+    </div>
+    <div v-if="validationError" class="validation-error">
+      {{ validationError }}
+    </div>
+  </div>
+</template>
+
+<script lang="ts">
+import { defineComponent, ref, computed, onMounted } from 'vue'
+import type { ShipToOrganization } from '@/types/organization'
+import { useShipToOrgSearchV2 } from '@/composables/useShipToOrgSearchV2'
+
+export default defineComponent({
+  name: 'OrderInternalShipToColumn',
+  props: {
+    orderId: {
+      type: String,
+      required: true,
+    },
+    soldToOrgId: {
+      type: String,
+      required: true,
+    },
+    isReadOnly: {
+      type: Boolean,
+      default: false,
+    },
+  },
+  setup(props, { emit }) {
+    const { fetchShipToOrgs, loading, shipToOrgs } = useShipToOrgSearchV2()
+    const selectedShipTo = ref('')
+    const validationError = ref('')
+
+    const shipToOptions = computed(() => shipToOrgs.value || [])
+
+    const selectedOrg = computed(() => {
+      return shipToOptions.value.find(o => o.id === selectedShipTo.value) || {}
+    })
+
+    const onShipToChange = () => {
+      validationError.value = ''
+      emit('ship-to-changed', selectedShipTo.value)
+    }
+
+    onMounted(async () => {
+      await fetchShipToOrgs(props.soldToOrgId)
+      if (shipToOptions.value.length === 1) {
+        selectedShipTo.value = shipToOptions.value[0].id
+      }
+    })
+
+    return {
+      loading,
+      shipToOptions,
+      selectedShipTo,
+      selectedOrg,
+      validationError,
+      onShipToChange,
+    }
+  },
+})
+</script>
