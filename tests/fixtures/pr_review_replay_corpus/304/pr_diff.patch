+import { defineComponent, ref, computed } from 'vue'
+import type { ShipToOrganization } from '@/types/organization'
+
+class ShipToOrganizationModalV2 {
+  searchQuery: string = ''
+  organizations: ShipToOrganization[] = []
+
+  filterOrgs(query: string): ShipToOrganization[] {
+    return this.organizations.filter(o =>
+      o.name.toLowerCase().includes(query.toLowerCase()) ||
+      o.sapCustomerId.includes(query)
+    )
+  }
