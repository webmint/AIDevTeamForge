+
+export default defineComponent({
+  name: 'ShipToOrganizationModalV2',
+  setup() {
+    const searchQuery = ref('')
+    const orgs = ref<ShipToOrganization[]>([])
+    return { searchQuery, orgs }
+  },
+})
+</script>
