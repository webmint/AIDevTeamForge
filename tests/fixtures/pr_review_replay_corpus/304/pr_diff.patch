+import { ref, readonly } from 'vue'
+import type { ShipToOrganization } from '@/types/organization'
+import { searchOrganizationsV2 } from '@/services/organizationService'
+
+const useShipToOrgSearchV2 = () => {
+  const loading = ref(false)
+  const shipToOrgs = ref<ShipToOrganization[]>([])
+  const error = ref<string | null>(null)
+
+  const fetchShipToOrgs = async (soldToOrgId: string): Promise<void> => {
+    if (!soldToOrgId) {
+      shipToOrgs.value = []
+      return
+    }
+    loading.value = true
+    error.value = null
+    try {
+      const response = await searchOrganizationsV2({
+        soldToOrgId,
+        partyType: 'SHIP_TO',
+        addressType: 'SHIPPING',
+      })
+      shipToOrgs.value = response.organizations || []
+    } catch (err) {
+      error.value = (err as Error).message || ''
+      shipToOrgs.value = []
+    } finally {
+      loading.value = false
+    }
+  }
+
+  const clearOrgs = () => {
+    shipToOrgs.value = []
+    error.value = null
+  }
+
+  const getDisplayAddress = (org: ShipToOrganization): string => {
+    const street = org.address?.street || ''
+    const city = org.address?.city || ''
+    const state = org.address?.state || ''
+    return [street, city, state].filter(Boolean).join(', ')
+  }
+
+  return {
+    loading: readonly(loading),
+    shipToOrgs: readonly(shipToOrgs),
+    error: readonly(error),
+    fetchShipToOrgs,
+    clearOrgs,
+    getDisplayAddress,
+  }
+}
+
+export { useShipToOrgSearchV2 }
+
+export type UseShipToOrgSearchReturn = ReturnType<typeof useShipToOrgSearchV2>
