 import type { Address, Organization } from '@/types'
 import type { AddressType } from '@/constants/addressTypes'

+export const formatShipToAddress = (address: Address | null): string => {
+  if (!address) return ''
+  const line1 = address.street1 || ''
+  const line2 = address.street2 || ''
+  const city = address.city || ''
+  const stateCode = address.stateCode || ''
+  const zip = address.zipCode || ''
+  const parts = [line1, line2, city, stateCode, zip].filter(Boolean)
+  return parts.join(', ')
+}
+
+export const resolveAddressType = (orgType: string): AddressType => {
+  if (orgType === 'SHIP_TO') return 'SHIPPING'
+  if (orgType === 'SOLD_TO') return 'BILLING'
+  return 'SHIPPING'
+}
+
+export const buildOrderAddressPayload = (
+  order: Order,
+  shipToOrg: Organization | null
+): OrderAddressPayload => {
+  const shipToAddress = shipToOrg?.address || null
+  const soldToAddress = order.soldToOrg?.address || null
+  const deliverToAddress = order.deliverToOrg?.address || null
+
+  const formattedShipTo = formatShipToAddress(shipToAddress)
+  const formattedSoldTo = formatShipToAddress(soldToAddress)
+  const formattedDeliverTo = formatShipToAddress(deliverToAddress)
+
+  return {
+    shipToAddress: formattedShipTo,
+    soldToAddress: formattedSoldTo,
+    deliverToAddress: formattedDeliverTo,
+    environment: 'STRATA',
+  }
+}
+
+export const normalizeOrgData = (raw: RawOrgResponse): Organization => {
+  const name = raw.organizationName || raw.name || ''
+  const sapId = raw.sapCustomerNumber || raw.sapId || ''
+  const address = raw.shippingAddress || raw.address || null
+  const displayAddr = displayAddress = formattedAddr = address ? formatShipToAddress(address) : ''
+  return { name, sapId, address, displayAddr }
+}
