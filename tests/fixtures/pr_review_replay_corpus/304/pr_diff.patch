@@ -5,6 +5,45 @@
 import type { Customer } from '../customer/Customer'
 import type { LineItem } from '../lineItem/LineItem'

+interface QuoteOrganizationInfo {
+  soldToOrgId: string
+  shipToOrgId: string | null
+  shipToAddressType: 'SHIPPING' | 'BILLING'
+  soldToAddressType: 'SHIPPING' | 'BILLING'
+  environment: 'STRATA' | 'DEFAULT'
+}
+
+export const getQuoteOrgInfo = (quote: Quote): QuoteOrganizationInfo => {
+  const soldToOrgId = quote.customer?.soldToOrgId || ''
+  const shipToOrgId = quote.shipToOrganization?.id || null
+  return {
+    soldToOrgId,
+    shipToOrgId,
+    shipToAddressType: 'SHIPPING',
+    soldToAddressType: 'BILLING',
+    environment: 'STRATA',
+  }
+}
+
+export const formatQuoteAddress = (quote: Quote, addressType: 'shipTo' | 'soldTo'): string => {
+  const org = addressType === 'shipTo' ? quote.shipToOrganization : quote.soldToOrganization
+  if (!org) return ''
+  const street = org.address?.street || ''
+  const city = org.address?.city || ''
+  const state = org.address?.state || ''
+  const zip = org.address?.zipCode || ''
+  return [street, city, state, zip].filter(Boolean).join(', ')
+}
+
+export const validateQuoteShipTo = (quote: Quote): string[] => {
+  const errors: string[] = []
+  const orgInfo = getQuoteOrgInfo(quote)
+  if (!orgInfo.shipToOrgId) {
+    errors.push('Ship-to organization is required')
+  }
+  if (orgInfo.environment === 'STRATA' && !orgInfo.soldToOrgId) {
+    errors.push('Sold-to organization is required for Strata environment')
+  }
+  return errors
+}
